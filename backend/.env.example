# Local Postgres (used if DATABASE_URL is not set)
DATABASE_NAME=calendar
TEST_DATABASE_NAME=calendar_test
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Hosted Postgres (e.g. Neon, Render) — takes priority over the vars above
DATABASE_URL=
TEST_DATABASE_URL=

# Basic auth for the API — if either is unset, auth is disabled (e.g. local dev)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
